{
  "name": "outfix-player",
  "version": "1.0.0",
  "description": "OutFix Player — Music & Video Player + Downloader",
  "main": "main.js",
  "author": {
    "name": "vexix-07",
    "email": "mostafamrbt7@gmail.comS"
  },
  "license": "MIT",
  "homepage": "https://github.com/vexix-07/outfix-player",
  "repository": {
    "type": "git",
    "url": "https://github.com/vexix-07/outfix-player.git"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --publish never"
  },
  "dependencies": {
    "music-metadata": "^7.14.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.vexix.outfix",
    "productName": "OutFix Player",
    "compression": "maximum",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!bin/**",
      "!node_modules/.cache/**",
      "!node_modules/@types/**",
      "!**/*.md",
      "!**/*.ts",
      "!**/*.map",
      "!**/test/**",
      "!**/tests/**",
      "!**/.github/**",
      "!**/.git/**",
      "!**/.vscode/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "logo.ico",
      "publisherName": "vexix-07",
      "electronLanguages": ["en-US"]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "OutFix Player",
      "menuCategory": "OutFix",
      "installerIcon": "logo.ico",
      "uninstallerIcon": "logo.ico",
      "installerHeaderIcon": "logo.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "artifactName": "OutFix-Player-Setup-${version}.${ext}"
    },
    "publish": null
  }
}